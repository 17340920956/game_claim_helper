# === 复制为 .env 后在服务器上填写 ===
# cp .env.docker.example .env && vim .env

# ---- MySQL（与 docker-compose.prod.yml 一致）----
MYSQL_ROOT_PASSWORD=请改为强密码_root
MYSQL_PASSWORD=请改为强密码_gch

# ---- Redis ----
REDIS_PASSWORD=请改为强密码_redis

# ---- 应用对外端口（宿主机）----
APP_PORT=8000

# ---- 以下会覆盖 compose 内联的 DATABASE_URL / REDIS_URL 时：不要在本文件写死错误的库地址 ----
# compose 已为 app 注入正确的 DATABASE_URL、REDIS_URL，此处只需微信与其它配置：

EPIC_FREE_GAMES_URL=https://store.epicgames.com/en-US/free-games

WECHAT_OFFICIAL_APPID=你的AppID
WECHAT_OFFICIAL_SECRET=你的Secret
WECHAT_OFFICIAL_TOKEN=与公众平台服务器配置一致
WECHAT_OFFICIAL_AES_KEY=与公众平台一致

SCHEDULER_TIMEZONE=Asia/Shanghai
BASE_URL=https://你的域名

SECRET_KEY=至少32位随机字符串
ADMIN_API_KEY=管理接口用强随机密钥

# 可选
# QQ_BOT_API_URL=
# QQ_BOT_TOKEN=
